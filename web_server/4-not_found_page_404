#!/usr/bin/env bash
# Installs nginx, serves a page containing "Holberton School" at the root,
# configures /redirect_me to redirect with a 301, and sets up a custom
# 404 page containing "Ceci n'est pas une page".

apt-get update -y
apt-get install -y nginx

echo "Holberton School" > /var/www/html/index.html
echo "Ceci n'est pas une page" > /var/www/html/404.html

cat > /etc/nginx/sites-available/default << 'EOF'
server {
	listen 80 default_server;
	listen [::]:80 default_server;

	root /var/www/html;
	index index.html index.htm index.nginx-debian.html;

	server_name _;

	error_page 404 /404.html;

	location / {
		try_files $uri $uri/ =404;
	}

	location /redirect_me {
		return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;
	}
}
EOF

service nginx restart || service nginx start

